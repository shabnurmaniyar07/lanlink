<?xml version="1.0" encoding="utf-8"?>
<!--
  Paired-device tokens are encrypted with a key held in this phone's hardware
  keystore. A backup of the file would restore onto a device whose keystore
  cannot decrypt it, so nothing here is backed up or transferred: pair again on
  a new phone, which also means the PC's owner gets to approve the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
